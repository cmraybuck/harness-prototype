# FLUX TEAM-SHARED CONNECTION VALUES
# HARNESS_* names are retained compatibility settings during the FLUX transition.
# Give every teammate the same reachable host URL and model identifiers.
# For a host-only installation, the loopback default remains appropriate.
HARNESS_OLLAMA_HOST=http://127.0.0.1:11434
# Comma-separated installed Ollama model identifiers, in startup-selection order.
# Leave blank until a compatible model has been selected and installed.
# e.g. HARNESS_MODELS=devstral-small-2:latest,qwen3:8b,qwen3-vl:8b
HARNESS_MODELS=

# PER-TEAMMATE VALUE
# Optional: select the profile from `tailscale switch --list` that can reach the
# Ollama host. Leave it empty to keep the currently active Tailscale profile.
HARNESS_TAILSCALE_PROFILE=

# HOST-ONLY PROVISIONING VALUES
# Teammates do not need to change these. The host script forwards the private
# Tailscale port to this loopback-only Ollama API.
HARNESS_OLLAMA_LOCAL_HOST=http://127.0.0.1:11434
HARNESS_TAILSCALE_SERVE_PORT=11434

# OPTIONAL FLUX TUNING
# Generation randomness, from 0 to 2; lower values are more predictable.
HARNESS_TEMPERATURE=0.15

# Model context window in tokens; larger values need more memory (positive integer).
HARNESS_CONTEXT_LENGTH=4096

# Larger context reserved for evidence-gated repository research. This must be at
# least HARNESS_CONTEXT_LENGTH and requires additional Ollama memory.
HARNESS_RESEARCH_CONTEXT_LENGTH=32768

# Maximum model/tool rounds per prompt before retaining results and stopping.
HARNESS_MAX_TOOL_ROUNDS=8

# Additional bounded tool rounds only for backend-required repository evidence.
HARNESS_INSPECTION_TOOL_ROUND_ALLOWANCE=4

# Stop a turn before executing the same exact tool operation a third time.
HARNESS_IDENTICAL_TOOL_CALL_LIMIT=2

# Stop a turn after this many consecutive failed tool results.
HARNESS_CONSECUTIVE_TOOL_FAILURE_LIMIT=3

# TEST EXECUTION
# Shell-free JSON argument arrays. The targeted command must contain one
# standalone {targets} argument; each model-selected target replaces it as a
# separate argument. The full-suite command must not contain that placeholder.
HARNESS_TEST_COMMAND=["uv","run","python","-m","unittest","discover","-s","tests","-v"]
HARNESS_TARGETED_TEST_COMMAND=["uv","run","python","-m","unittest","-v","{targets}"]

# Named shell-free project checks. Each check has a default command and may have
# exact named target commands. Model-provided command text is never accepted.
HARNESS_CHECKS={"build":{"command":["uv","build"]},"lint":{"command":["uv","run","ruff","check","."],"targets":{"source":["uv","run","ruff","check","src"]}}}

# Named shell-free background services. cwd stays inside the active workspace.
# ready_text is optional; when present it must appear in stdout or stderr before
# startup_timeout_seconds or the process is stopped and startup fails.
HARNESS_SERVICES={"web":{"command":["python","-u","-m","http.server","8765"],"cwd":".","ready_text":"Serving HTTP","startup_timeout_seconds":10}}

# Hard runtime limit and maximum captured bytes for each output stream.
HARNESS_TEST_TIMEOUT_SECONDS=120
HARNESS_TEST_OUTPUT_LIMIT=12000

# Bare executable names permitted for model-supplied, shell-free run_command
# argument arrays. Built-in shell executables remain denied even if listed here.
HARNESS_COMMAND_ALLOWED_EXECUTABLES=git,uv,python,python3,pytest,ruff,mypy,node,npm,npx,cargo,go,dotnet

# TOOL APPROVAL POLICIES
# Allowed values: always_allow, ask_first, or deny. run_tests, run_checks,
# run_command, start_service, and stop_service use the execution policy, and
# apply_file_changes uses the write policy.
HARNESS_READ_ONLY_POLICY=always_allow
HARNESS_WRITE_POLICY=ask_first
HARNESS_EXECUTION_POLICY=ask_first
HARNESS_NETWORK_POLICY=ask_first
HARNESS_DEPLOYMENT_POLICY=ask_first

# Append-only JSONL interaction logs. Relative paths start at the project root.
HARNESS_LOG_DIRECTORY=work/logs

# Versioned SQLite application state. The default is the platform FLUX data
# directory (for example, %LOCALAPPDATA%\FLUX\state.sqlite3 on Windows).
# Relative overrides start at the project root.
# HARNESS_STATE_DATABASE_PATH=work/state.sqlite3

# Comma-separated environment-variable names whose nonempty values must be
# replaced with [REDACTED] everywhere in logs (for example, MY_API_KEY,TOKEN).
HARNESS_LOG_REDACT_VARIABLES=
